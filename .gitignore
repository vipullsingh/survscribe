# Node & Package Managers
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Turborepo
.turbo/

# Build & Output Directories
dist/
build/
out/
.next/
bin/

# Environment & Local Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Expo / React Native (mobile)
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts
# Native projects are generated on demand by `expo prebuild` (Continuous Native
# Generation) and are not committed. Run `pnpm --filter @survscribe/mobile prebuild`
# to (re)create them locally.
apps/mobile/ios/
apps/mobile/android/
.bundle/

# IDEs & System Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userossc
*.sln.docstates
.DS_Store
Thumbs.db

# OS / Scratch / Temporary Files
tmp/
*.log

# This is a pnpm workspace. An npm or yarn lockfile here means someone ran the wrong
# package manager, and two lockfiles resolve to two different dependency trees.
package-lock.json
yarn.lock

# Local database volumes and generated coverage
coverage/
*.mmdb
