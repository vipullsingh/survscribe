# SurvScribe API -- example environment.
#
# Copy to apps/backend/.env and fill in. .env is gitignored and must never be committed.
# Nothing here has a production-shaped default: config.Load() rejects a missing
# DATABASE_URL rather than quietly falling back to localhost.
#
# Secrets management: see documentation/decisions/ADR-0008-configuration-and-secrets.md.
# In development, values come from this file. In every deployed environment they are
# injected by the platform's secret store and never written to disk.

# ---------------------------------------------------------------- runtime
SURVSCRIBE_ENV=development          # development | test | staging | production
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=15s
APP_VERSION=0.1.0-dev

# ---------------------------------------------------------------- database
# Port 5433 matches deployments/docker-compose.yml, which deliberately avoids 5432 so a
# migration command cannot hit a local Postgres holding real data by accident.
DATABASE_URL=postgres://survscribe:devpassword@localhost:5433/survscribe_dev?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=10s
DB_HEALTHCHECK_PERIOD=30s

# ---------------------------------------------------------------- logging
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text  (text is easier to read locally)

# ================================================================
# NOT YET CONSUMED BY ANY CODE -- listed so the shape is agreed before sprint_0003.
# Every one of these is a secret. None may be logged, echoed in an error, or returned
# in an API response (CLAUDE.md section 14 constraint 17).
# ================================================================

# ---- Token signing (ADR-0003, ADR-0008) -------------------------------------
# RS256. The PRIVATE key never leaves the secret store and is never committed.
# In development, generate a throwaway pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-dev.pem
#   openssl rsa -in jwt-dev.pem -pubout -out jwt-dev.pub
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# JWT_KEY_ID=dev-1
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h

# ---- Password and token hashing (ADR-0005) ----------------------------------
# ARGON2_MEMORY_KIB=65536
# ARGON2_ITERATIONS=3
# ARGON2_PARALLELISM=2

# ---- Geo-IP (ADR-0006) -------------------------------------------------------
# Local MaxMind GeoLite2 database. No PII leaves the process; enrichment is
# best-effort and a failure never blocks authentication.
# GEOIP_MMDB_PATH=./data/GeoLite2-City.mmdb

# ---- External providers (ADR-0002) -------------------------------------------
# Vendors are selected; accounts are not yet provisioned. See
# documentation/decisions/vendor-tracker.md for who owns each key.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# SENDGRID_API_KEY=
# GOOGLE_MAPS_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Media storage -----------------------------------------------------------
# MEDIA_BUCKET=
# MEDIA_UPLOAD_MAX_BYTES=52428800
