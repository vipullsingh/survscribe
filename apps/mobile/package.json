{
  "name": "@survscribe/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SurvScribe Expo (React Native + TypeScript) field application. Offline-first; every one of the 15 stages works without connectivity.",
  "license": "UNLICENSED",
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "build": "tsc --noEmit",
    "clean": "rimraf node_modules .expo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@survscribe/types": "workspace:*",
    "@survscribe/ui": "workspace:*",
    "expo": "~57.0.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "jest": {
    "preset": "jest-expo"
  }
