# SurvScribe mobile -- example environment.
#
# Copy to apps/mobile/.env. react-native-dotenv inlines these values into the JavaScript
# bundle at build time, which means they are READABLE ON ANY DEVICE THE APP SHIPS TO.
#
# Never put a secret in this file. No API keys for SMS, email, maps, LLM or OCR
# providers: the app reaches those services only through the SurvScribe backend, which
# holds the credentials. A key placed here is a published key (ADR-0008).
#
# Values are inlined at bundle time, so changing .env requires restarting Metro with
# --reset-cache.

SURVSCRIBE_ENV=development                      # development | staging | production

# Android emulators reach the host machine at 10.0.2.2; an iOS simulator uses localhost.
SURVSCRIBE_API_BASE_URL=http://10.0.2.2:8080/api/v1

# ================================================================
# NOT YET CONSUMED -- shape agreed ahead of the sprints that need it.
# ================================================================

# ---- Local encrypted store (D20, CR-NF2) -------------------------------------
# The SQLCipher passphrase is NOT configured here. It is generated on first run and
# held in the iOS Keychain / Android Keystore; a passphrase in a bundle would make the
# AES-256 encryption of the offline claim database decorative.
#
# WatermelonDB + SQLCipher are ordinary autolinked native modules under bare React
# Native: install, then rebuild the app (a Metro reload is not enough).

# ---- Offline session (CR-A12) -----------------------------------------------
# SESSION_IDLE_LOCK_MINUTES=15
# OFFLINE_GRACE_DAYS=30
